{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "josh-brain",
  "permission": "allow",
  "instructions": [
    "AGENTS.md",
    "continue.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "tools": {
    "playwright": false
  }
}
